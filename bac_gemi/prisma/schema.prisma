generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("STUDENT") // Admin can change exam date
  
  // Economy & Gamification
  totalStars    Int       @default(0)
  weeklyStars   Int       @default(0)
  monthlyStars  Int       @default(0)
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastStudyDate DateTime?

  // NextAuth related
  accounts      Account[]
  sessions      Session[]

  // Relations
  relationshipId  String?
  relationship    PartnerRelationship? @relation("PartnerDetails", fields: [relationshipId], references: [id])
  
  tasksCreated    Task[]            @relation("TaskCreator")
  tasksReviewed   TaskReview[]
  messages        Message[]
  achievements    UserAchievement[]
  activities      DailyActivity[]
  notesSent       MotivationNote[]  @relation("NoteSender")
  
  participations  ChallengeParticipation[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PartnerRelationship {
  id           String   @id @default(cuid())
  joinCode     String   @unique
  createdAt    DateTime @default(now())
  examDate     DateTime // The Bac exam date for this duo

  users        User[]   @relation("PartnerDetails")
  
  tasks        Task[]
  challenges   Challenge[]
  sessions     StudySession[]
  pomodoros    PomodoroSession[]
  messages     Message[]
  canvasRooms  CanvasRoom[]
  notes        MotivationNote[]
  pet          Pet?
}

model Task {
  id             String   @id @default(cuid())
  title          String
  description    String?
  subject        String   // Math, Physics, Science, etc.
  difficulty     String   // Easy, Medium, Hard
  starReward     Int      @default(1)
  dueDate        DateTime?
  status         String   @default("PENDING") // PENDING, ACTIVE, WAITING_VALIDATION, COMPLETED, REJECTED
  
  creatorId      String
  creator        User     @relation("TaskCreator", fields: [creatorId], references: [id])
  
  relationshipId String
  relationship   PartnerRelationship @relation(fields: [relationshipId], references: [id])

  reviews        TaskReview[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model TaskReview {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id])
  reviewerId  String
  reviewer    User     @relation(fields: [reviewerId], references: [id])
  status      String   // APPROVED, REJECTED
  comment     String?
  createdAt   DateTime @default(now())
}

model Challenge {
  id             String   @id @default(cuid())
  title          String
  description    String
  reward         Int
  deadline       DateTime
  relationshipId String
  relationship   PartnerRelationship @relation(fields: [relationshipId], references: [id])
  
  participations ChallengeParticipation[]
  createdAt      DateTime @default(now())
}

model ChallengeParticipation {
  id          String    @id @default(cuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  progress    Int       @default(0)
  completedAt DateTime?
}

model Achievement {
  id          String   @id @default(cuid())
  name        String   // e.g., "Math Master"
  description String
  icon        String
  criteria    Json     // Rules to unlock
  
  users       UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  unlockedAt    DateTime    @default(now())
}

model Message {
  id             String   @id @default(cuid())
  content        String
  senderId       String
  sender         User     @relation(fields: [senderId], references: [id])
  relationshipId String
  relationship   PartnerRelationship @relation(fields: [relationshipId], references: [id])
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model CanvasRoom {
  id             String   @id @default(cuid())
  relationshipId String
  relationship   PartnerRelationship @relation(fields: [relationshipId], references: [id])
  state          Json     // Excalidraw state elements
  updatedAt      DateTime @updatedAt
}

model StudySession {
  id             String   @id @default(cuid())
  relationshipId String
  relationship   PartnerRelationship @relation(fields: [relationshipId], references: [id])
  startTime      DateTime @default(now())
  endTime        DateTime?
  duration       Int?     // in seconds
}

model PomodoroSession {
  id             String   @id @default(cuid())
  relationshipId String
  relationship   PartnerRelationship @relation(fields: [relationshipId], references: [id])
  mode           String   // 25/5, 50/10, Custom
  focusTime      Int
  breakTime      Int
  startTime      DateTime @default(now())
  status         String   // ACTIVE, PAUSED, COMPLETED
}

model Pet {
  id             String   @id @default(cuid())
  relationshipId String   @unique
  relationship   PartnerRelationship @relation(fields: [relationshipId], references: [id])
  type           String   @default("CAPYBARA")
  level          Int      @default(1)
  experience     Int      @default(0)
  
  unlocks        PetUnlock[]
}

model PetUnlock {
  id       String @id @default(cuid())
  petId    String
  pet      Pet    @relation(fields: [petId], references: [id])
  itemType String // HAT, GLASSES, etc.
  itemId   String
}

model DailyActivity {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  date        DateTime @default(dbgenerated("CURRENT_DATE"))
  starsEarned Int      @default(0)
  tasksDone   Int      @default(0)
  focusMinutes Int     @default(0)

  @@unique([userId, date])
}

model MotivationNote {
  id             String   @id @default(cuid())
  content        String
  senderId       String
  sender         User     @relation("NoteSender", fields: [senderId], references: [id])
  relationshipId String
  relationship   PartnerRelationship @relation(fields: [relationshipId], references: [id])
  isPinned       Boolean  @default(false)
  createdAt      DateTime @default(now())
}
